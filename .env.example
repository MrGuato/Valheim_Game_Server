# ---------------------------------------------------------------------------
# Server identity (the same variable names lloesche/valheim-server uses, so an
# existing .env keeps working)
# ---------------------------------------------------------------------------
SERVER_NAME=Saberguard Valheim
WORLD_NAME=Midgard
# 5+ characters and it must not appear inside SERVER_NAME (Valheim rules).
SERVER_PASS=StrongSecretHere
# true = listed in the community server browser, false = direct connect only
SERVER_PUBLIC=true
# true = allow Xbox / Microsoft Store players (also uncomment 2458/udp in docker-compose.yaml)
CROSSPLAY=false
TZ=America/New_York

# ---------------------------------------------------------------------------
# Image
# ---------------------------------------------------------------------------
IMAGE_REPOSITORY=ghcr.io/mrguato/valheim_game_server
# use a vX.Y.Z tag for production, latest tracks main
IMAGE_TAG=latest
CONTAINER_NAME=valheim

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# UID/GID the server runs as; match the owner of ./config and ./data. PUID=0 runs as root.
PUID=1000
PGID=1000
# validate / update the game files through SteamCMD on every container start
UPDATE_ON_START=true
SERVER_PORT=2456
QUERY_PORT=2457
# seconds the container waits for the world to save on shutdown
STOP_TIMEOUT=120

# ---------------------------------------------------------------------------
# Optional game settings, empty = Valheim defaults
# ---------------------------------------------------------------------------
# world save interval in seconds (default 1800)
SAVE_INTERVAL=
# number of automatic world backups Valheim keeps (default 4)
WORLD_BACKUPS=
# seconds between the first automatic backups (default 7200) and the later ones (default 43200)
BACKUP_SHORT=
BACKUP_LONG=
# normal | casual | easy | hard | hardcore | immersive | hammer
SERVER_PRESET=
# space separated key:value pairs, e.g. "combat:hard deathpenalty:casual raids:none"
SERVER_MODIFIERS=
# space separated keys, e.g. "nobuildcost passivemobs nomap"
SERVER_SETKEYS=
# anything else to append to the server command line, verbatim
SERVER_ARGS=
